// Teskel database schema
// Postgres-targeted Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums -----------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum FileType {
  FILE
  FOLDER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentStepType {
  THINK
  READ_FILE
  WRITE_FILE
  RUN_COMMAND
  SEARCH
  GIT
  DIFF
  REVIEW
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ChangeSetStatus {
  DRAFT
  PENDING_REVIEW
  APPLIED
  REJECTED
  REVERTED
}

enum FileChangeType {
  CREATE
  UPDATE
  DELETE
  RENAME
}

enum FileChangeStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TerminalStatus {
  ACTIVE
  CLOSED
}

enum RuleScope {
  GLOBAL
  WORKSPACE
  PROJECT
  FILE
}

enum KnowledgeType {
  TEXT
  FILE
  URL
  NOTE
}

enum ArtifactType {
  CODE
  DOCUMENT
  CHART
  WEBAPP
  IMAGE
}

// ----------------------------- Auth.js models -----------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  tokenVersion  Int       @default(0)
  image         String?
  bio           String?
  preferences   Json?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  chatThreads      ChatThread[]
  agentRuns        AgentRun[]
  terminalSessions TerminalSession[]
  apiKeys          ApiKey[]
  designSessions   DesignSession[]
  documents        Document[]
  notifications    Notification[]
  artifacts        Artifact[]
  reviewComments   ReviewComment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------- Workspace -----------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner             User               @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members           WorkspaceMember[]
  projects          Project[]
  rules             Rule[]
  knowledge         KnowledgeItem[]
  integrations      Integration[]
  apiKeys           ApiKey[]
  extensions        Extension[]
  webhooks          Webhook[]
  subscription      Subscription?
  skills            Skill[]
  usageRecords      UsageRecord[]
  slashCommands     SlashCommand[]
  aiPermissions     AIPermission[]
  fusionRoutings    FusionRouting[]
  fusionJudges      FusionJudge[]
  fusionRequestLogs FusionRequestLog[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ----------------------------- Project -----------------------------

model Project {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  slug          String
  description   String?
  storageKey    String
  gitRepoUrl    String?
  defaultBranch String   @default("main")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files            FileNode[]
  chatThreads      ChatThread[]
  agentRuns        AgentRun[]
  changeSets       ChangeSet[]
  terminalSessions TerminalSession[]
  gitState         GitState?
  rules            Rule[]
  knowledge        KnowledgeItem[]
  designSessions   DesignSession[]
  documents        Document[]
  artifacts        Artifact[]
  skills           Skill[]
  qualityScores    QualityScore[]
  embeddings       Embedding[]
  failureLogs      FailureLog[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([updatedAt])
}

model FileNode {
  id        String   @id @default(cuid())
  projectId String
  parentId  String?
  type      FileType
  name      String
  path      String
  language  String?
  content   String?  @db.Text
  size      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   FileNode?  @relation("FileNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children FileNode[] @relation("FileNodeChildren")

  @@unique([projectId, path])
  @@index([projectId, parentId])
}

// ----------------------------- Chat -----------------------------

model ChatThread {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  agentRuns AgentRun[]

  @@index([projectId])
  @@index([userId])
  @@index([projectId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  threadId  String
  role      MessageRole
  content   String      @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([threadId, createdAt])
}

// ----------------------------- Agent -----------------------------

model AgentRun {
  id        String      @id @default(cuid())
  projectId String
  threadId  String?
  userId    String
  status    AgentStatus @default(QUEUED)
  goal      String      @db.Text
  plan      Json?
  result    Json?
  error     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thread        ChatThread?    @relation(fields: [threadId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps         AgentStep[]
  changeSets    ChangeSet[]
  qualityScores QualityScore[]

  @@index([projectId])
  @@index([threadId])
  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([projectId, createdAt])
}

model AgentStep {
  id         String        @id @default(cuid())
  agentRunId String
  type       AgentStepType
  title      String
  status     StepStatus    @default(PENDING)
  input      Json?
  output     Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([agentRunId, createdAt])
}

// ----------------------------- Changes -----------------------------

model ChangeSet {
  id          String          @id @default(cuid())
  projectId   String
  agentRunId  String?
  title       String
  description String?
  status      ChangeSetStatus @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun       AgentRun?       @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  fileChanges    FileChange[]
  reviewComments ReviewComment[]

  @@index([projectId])
  @@index([agentRunId])
  @@index([projectId, status])
}

model FileChange {
  id          String           @id @default(cuid())
  changeSetId String
  filePath    String
  oldPath     String?
  changeType  FileChangeType
  oldContent  String?          @db.Text
  newContent  String?          @db.Text
  diff        String?          @db.Text
  status      FileChangeStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  changeSet ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)

  @@index([changeSetId])
  @@index([changeSetId, filePath])
}

// ----------------------------- Terminal -----------------------------

model TerminalSession {
  id        String         @id @default(cuid())
  projectId String
  userId    String
  title     String
  cwd       String
  status    TerminalStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  commands TerminalCommand[]

  @@index([projectId])
  @@index([userId])
}

model TerminalCommand {
  id        String   @id @default(cuid())
  sessionId String
  command   String   @db.Text
  output    String?  @db.Text
  exitCode  Int?
  createdAt DateTime @default(now())

  session TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

// ----------------------------- Git -----------------------------

model GitState {
  id             String   @id @default(cuid())
  projectId      String   @unique
  branch         String
  status         Json?
  lastCommitHash String?
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ----------------------------- Rules & Knowledge -----------------------------

/// Constraint: At least one of `workspaceId` or `projectId` should be set.
model Rule {
  id          String    @id @default(cuid())
  workspaceId String?
  projectId   String?
  scope       RuleScope
  filePattern String?
  title       String
  content     String    @db.Text
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@index([scope, enabled])
}

model KnowledgeItem {
  id          String        @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  type        KnowledgeType
  content     String        @db.Text
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
}

model Integration {
  id              String   @id @default(cuid())
  workspaceId     String
  provider        String
  name            String
  encryptedConfig String   @db.Text
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  name        String
  hashedKey   String    @unique
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, createdAt])
}

// ----------------------------- Design & Canvas -----------------------------

model DesignSession {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions DesignVersion[]

  @@index([projectId])
  @@index([userId])
}

model DesignVersion {
  id        String   @id @default(cuid())
  sessionId String
  code      String   @db.Text
  prompt    String   @db.Text
  createdAt DateTime @default(now())

  session DesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

// ----------------------------- Documents & Artifacts -----------------------------

model Document {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model Artifact {
  id        String       @id @default(cuid())
  projectId String
  userId    String
  title     String
  type      ArtifactType
  content   String       @db.Text
  language  String?
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

// ----------------------------- Extensions -----------------------------

model Extension {
  id          String   @id @default(cuid())
  workspaceId String
  registryId  String
  name        String
  author      String
  version     String
  config      Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, registryId])
  @@index([workspaceId])
}

// ----------------------------- Review Comments -----------------------------

model ReviewComment {
  id          String   @id @default(cuid())
  changeSetId String
  filePath    String
  line        Int
  content     String   @db.Text
  suggestion  String?  @db.Text
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  changeSet ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)

  // `author` is a soft display reference (username/handle) and may be left null
  // when the author user has been deleted. `user` is the optional FK to User.
  author String? // soft reference for display (e.g. username / handle)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([changeSetId])
  @@index([userId])
}

// ----------------------------- Billing -----------------------------

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

enum PlanTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(ACTIVE)
  plan                 PlanTier           @default(FREE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  // Idempotency: the Stripe event.id of the last event we processed for
  // this subscription. Webhook handlers check this to drop duplicate
  // deliveries from Stripe's at-least-once retries.
  lastEventId          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id          String   @id @default(cuid())
  workspaceId String
  type        String // 'ai_tokens' | 'compute_minutes' | 'storage_mb'
  quantity    Int
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, createdAt])
}

// ----------------------------- Notifications -----------------------------

enum NotificationType {
  AGENT_COMPLETED
  AGENT_FAILED
  CHANGESET_READY
  CHANGESET_APPLIED
  TEAM_INVITE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ----------------------------- Webhook idempotency -----------------------------
//
// NOTE: The `ProcessedWebhookEvent` model is declared in the Webhooks section
// below. The matching CREATE TABLE migration was added earlier
// (20260614030000_add_failure_log_embedding_processed_webhook_event).

// ----------------------------- Webhooks -----------------------------

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  secret      String
  events      String[] // array of event types
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  response   String?  @db.Text
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

/// Idempotency record for already-processed webhook deliveries,
/// keyed by the provider-supplied event id.
model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  source    String
  createdAt DateTime @default(now())

  @@index([source])
}

// ----------------------------- Skills -----------------------------

/// Constraint: At least one of `workspaceId` or `projectId` should be set.
model Skill {
  id          String   @id @default(cuid())
  projectId   String?
  workspaceId String?
  name        String
  slug        String
  description String
  content     String   @db.Text
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@unique([projectId, slug])
  @@index([projectId])
  @@index([workspaceId])
  @@index([projectId, enabled])
}

// ----------------------------- Fusion (Model Orchestration) -----------------------------
//
// Fusion is a lightweight orchestration layer over the models the platform
// already connects via Integrations. Only two configs are persisted — Routing
// (how requests fan out) and Judge (how answers reconcile) — plus a request log
// that powers Overview + Playground metrics. Models are NOT stored; they are
// derived at runtime from enabled Integrations × the provider catalog.

model FusionRouting {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  // sequential | parallel | fallback | cost | latency
  strategy    String
  // { steps: string[] (provider:modelId), weights, maxFanout }
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FusionJudge {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  judgeModelId String?
  // consensus | majority | merge | debate
  mode         String
  // { confidenceThreshold }
  config       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FusionRequestLog {
  id          String   @id @default(cuid())
  workspaceId String
  modelId     String?
  provider    String
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Float    @default(0)
  latencyMs   Int      @default(0)
  success     Boolean  @default(true)
  error       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ----------------------------- Commands -----------------------------

model SlashCommand {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String
  template    String   @db.Text
  variables   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ----------------------------- AI Permissions -----------------------------

enum PermissionAction {
  ALLOW
  ASK
  DENY
}

model AIPermission {
  id          String           @id @default(cuid())
  workspaceId String
  tool        String // "file_edit", "file_delete", "terminal", "git_push", "agent_run", etc.
  pattern     String           @default("*") // glob pattern for file paths or commands
  action      PermissionAction @default(ASK)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, tool, pattern])
  @@index([workspaceId])
}

// ----------------------------- Quality Engine -----------------------------

model QualityScore {
  id           String   @id @default(cuid())
  agentRunId   String?
  projectId    String
  score        Float
  grade        String
  dimensions   Json
  suggestions  Json?
  confidence   Float
  modelUsed    String
  pipelineUsed String
  patternUsed  String
  tokensUsed   Int      @default(0)
  costEstimate Float    @default(0)
  durationMs   Int      @default(0)
  createdAt    DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([agentRunId])
}

model FailureLog {
  id             String   @id @default(cuid())
  projectId      String?
  taskType       String
  modelId        String
  errorType      String
  errorMessage   String
  context        String
  resolution     String?
  preventionHint String
  createdAt      DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([taskType, modelId])
  @@index([errorType])
  @@index([createdAt])
  @@index([projectId])
}

model Embedding {
  id        String   @id @default(cuid())
  projectId String
  filePath  String
  chunkType String
  chunkName String?
  startLine Int
  endLine   Int
  content   String   @db.Text
  vector    Bytes
  model     String   @default("text-embedding-3-small")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, filePath, startLine])
  @@index([projectId, chunkType])
  @@index([projectId, filePath])
  @@index([projectId, createdAt])
}
